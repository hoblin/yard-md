#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "yard_md"

parser = OptionParser.new(<<~HELP)
  Usage: yard-md [output dir]

  Run in a project. Documents every gem its bundle resolves on this platform
  as Markdown, each into <output dir>/<gem>-<version>/: a page per class and
  module, the index mdri reads, the README and the files its .yardopts
  names, and its doc/, docs/, example(s)/ and sample(s)/ directories. A gem
  whose directory exists is skipped, so the output directory is a cache several
  projects can share.

  The output directory defaults to gem-docs/ in XDG_CACHE_HOME, or in ~/.cache
  when that is unset, empty or relative: here, #{YardMd::CACHE}.

  Prints each gem it documents. A gem it cannot document is reported on stderr
  and the rest go on; the exit status says whether every gem is documented.
  What YARD could not process in a gem is reported on stderr under its name,
  and the gem still counts as documented.

  Options: -h, --help shows this; -v, --version prints the version.
HELP
parser.version = YardMd::VERSION

begin
  arguments = parser.parse(ARGV)
  abort parser.help if arguments.size > 1
  exit YardMd::Bundle.new(*arguments).document
rescue OptionParser::ParseError, Bundler::BundlerError
  parser.abort
end
